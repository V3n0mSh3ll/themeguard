[
  {"id": "ws_c99", "pattern": "(?:c99|c100)(?:shell|_shell|madshell)", "severity": "critical", "description": "c99 webshell detected"},
  {"id": "ws_r57", "pattern": "r57(?:shell|_shell)", "severity": "critical", "description": "r57 webshell detected"},
  {"id": "ws_wso", "pattern": "(?:WSO|wso)\\s*(?:\\d|shell|web)", "severity": "critical", "description": "WSO webshell detected"},
  {"id": "ws_filesman", "pattern": "FilesMan|filesman", "severity": "critical", "description": "FilesMan webshell detected"},
  {"id": "ws_alfa", "pattern": "(?:alfa|ALFA)(?:shell|_shell|Shell|Exploiter)", "severity": "critical", "description": "Alfa Shell detected"},
  {"id": "ws_b374k", "pattern": "b374k", "severity": "critical", "description": "b374k webshell detected"},
  {"id": "ws_p0wny", "pattern": "p0wny|p0wnyshell", "severity": "critical", "description": "p0wny shell detected"},
  {"id": "ws_anonymousfox", "pattern": "AnonymousFox|anonymousfox", "severity": "critical", "description": "AnonymousFox backdoor detected"},
  {"id": "ws_weevely", "pattern": "weevely", "severity": "critical", "description": "Weevely shell agent detected"},
  {"id": "ws_china_chopper", "pattern": "(?:china|chopper).*(?:eval|assert)\\s*\\(\\s*\\$_(?:POST|GET|REQUEST)", "severity": "critical", "description": "China Chopper style one-liner shell"},
  {"id": "ws_one_liner", "pattern": "<\\?php\\s+(?:eval|assert)\\s*\\(\\s*(?:base64_decode|gzinflate|str_rot13)\\s*\\(\\s*\\$_(?:POST|GET|REQUEST|COOKIE)", "severity": "critical", "description": "One-line PHP webshell"},
  {"id": "ws_mini_shell", "pattern": "<\\?php\\s+(?:system|exec|passthru|shell_exec)\\s*\\(\\s*\\$_(?:GET|POST|REQUEST)\\s*\\[", "severity": "critical", "description": "Minimal command execution shell"},
  {"id": "ws_upload_form", "pattern": "<form.*enctype=['\"]multipart/form-data['\"].*move_uploaded_file", "severity": "high", "description": "File upload form with move_uploaded_file - possible upload shell"},
  {"id": "ws_phpinfo_exposed", "pattern": "phpinfo\\s*\\(\\s*\\)", "severity": "medium", "description": "phpinfo() exposed - information disclosure"},
  {"id": "ws_file_manager", "pattern": "(?:scandir|glob|readdir).*(?:unlink|rmdir|rename|copy|chmod)", "severity": "high", "description": "File manager functionality detected"},
  {"id": "ws_database_shell", "pattern": "(?:mysql_connect|mysqli_connect|new\\s+PDO).*\\$_(?:GET|POST|REQUEST)", "severity": "critical", "description": "Database connection with user-supplied credentials"},
  {"id": "ws_reverse_shell", "pattern": "fsockopen\\s*\\(.*\\$_(?:GET|POST|REQUEST).*(?:fwrite|fputs)", "severity": "critical", "description": "Reverse shell - connecting back to attacker"},
  {"id": "ws_bind_shell", "pattern": "socket_(?:bind|listen|accept)", "severity": "critical", "description": "Bind shell - listening for inbound connections"},
  {"id": "ws_symlink_shell", "pattern": "symlink\\s*\\(.*(?:\\$_GET|\\$_POST|\\.\\.\\/)", "severity": "critical", "description": "Symlink shell - filesystem traversal attack"},
  {"id": "ws_proc_shell", "pattern": "proc_open\\s*\\(.*(?:cmd|bash|sh|powershell)", "severity": "critical", "description": "Process shell - spawning system shell"},
  {"id": "ws_backdoor_string", "pattern": "Backdoor\\.PHP|(?:web|php)_?shell|back_?connect|reverse_?connect", "severity": "critical", "description": "Explicit backdoor/webshell reference in code"},
  {"id": "ws_password_field", "pattern": "\\$(?:pass|password|pwd|auth|key)\\s*==\\s*['\"](?:md5\\()?[a-f0-9]{32}", "severity": "critical", "description": "Hardcoded shell password hash"},
  {"id": "ws_safe_mode_bypass", "pattern": "(?:safe_mode|open_basedir).*(?:bypass|disable|off)", "severity": "critical", "description": "Attempting to bypass PHP safe_mode or open_basedir"}
]
