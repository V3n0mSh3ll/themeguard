[
  {"id": "pl_license_nulled", "pattern": "(?:license|activation|register).*(?:null|bypass|crack|patch|keygen|free)", "severity": "high", "description": "License bypass/nulling mechanism detected"},
  {"id": "pl_phone_home", "pattern": "wp_remote_(?:get|post)\\s*\\(.*(?!api\\.wordpress\\.org)(?:activate|license|register|check|verify|update)", "severity": "high", "description": "Plugin phoning home for license verification"},
  {"id": "pl_admin_inject", "pattern": "add_action\\s*\\(\\s*['\"]admin_menu['\"].*(?:eval|base64|exec|system)", "severity": "critical", "description": "Malicious code injection via admin menu hook"},
  {"id": "pl_ajax_backdoor", "pattern": "wp_ajax_nopriv_.*(?:eval|base64_decode|exec|system|passthru|shell_exec)", "severity": "critical", "description": "Unauthenticated AJAX endpoint with dangerous functions"},
  {"id": "pl_nonce_bypass", "pattern": "(?:wp_verify_nonce|check_admin_referer).*(?:true|1)\\s*;\\s*//", "severity": "high", "description": "Nonce verification bypass (always returns true)"},
  {"id": "pl_capability_bypass", "pattern": "current_user_can\\s*\\(\\s*['\"](?:manage_options|administrator)['\"]\\s*\\)\\s*\\|\\|\\s*true", "severity": "critical", "description": "Capability check bypass - grants admin access to all"},
  {"id": "pl_update_hijack", "pattern": "pre_set_site_transient_update_(?:plugins|themes).*(?:eval|base64|exec)", "severity": "critical", "description": "Plugin/theme update mechanism hijacked"},
  {"id": "pl_options_backdoor", "pattern": "update_option\\s*\\(\\s*['\"](?:active_plugins|admin_email|siteurl|home|blogname)['\"].*\\$_(?:GET|POST|REQUEST)", "severity": "critical", "description": "Critical WP options modified via user input"},
  {"id": "pl_user_create_stealth", "pattern": "wp_create_user\\s*\\(|wp_insert_user\\s*\\(.*['\"]administrator['\"]", "severity": "critical", "description": "Stealth admin user creation"},
  {"id": "pl_role_escalation", "pattern": "(?:WP_User|wp_update_user|add_role|add_cap).*['\"](?:administrator|manage_options)['\"]", "severity": "critical", "description": "Role escalation - adding admin capabilities"},
  {"id": "pl_db_query_inject", "pattern": "\\$wpdb->(?:query|prepare|get_results)\\s*\\(.*\\$_(?:GET|POST|REQUEST|COOKIE)", "severity": "critical", "description": "SQL injection via unsanitized user input in $wpdb"},
  {"id": "pl_file_editor", "pattern": "file_put_contents\\s*\\(.*(?:ABSPATH|WP_CONTENT_DIR|WP_PLUGIN_DIR|TEMPLATEPATH)", "severity": "high", "description": "Writing files to WordPress core directories"},
  {"id": "pl_rest_api_backdoor", "pattern": "register_rest_route\\s*\\(.*(?:eval|exec|system|base64|file_put_contents)", "severity": "critical", "description": "REST API endpoint with dangerous function execution"},
  {"id": "pl_shortcode_exec", "pattern": "add_shortcode\\s*\\(.*(?:eval|exec|system|base64_decode|assert)", "severity": "critical", "description": "Shortcode executing dangerous functions"},
  {"id": "pl_widget_backdoor", "pattern": "class.*extends\\s+WP_Widget.*(?:eval|exec|system|base64_decode)", "severity": "critical", "description": "Widget class containing backdoor code"},
  {"id": "pl_cron_stealth", "pattern": "wp_schedule_(?:event|single_event)\\s*\\(.*(?:eval|base64|exec|curl|file_get_contents\\s*\\(\\s*['\"]http)", "severity": "critical", "description": "Scheduled cron job with malicious execution"},
  {"id": "pl_deactivation_persist", "pattern": "register_deactivation_hook.*(?:eval|exec|wp_remote|file_put|copy\\s*\\()", "severity": "critical", "description": "Plugin persists malicious code on deactivation"},
  {"id": "pl_activation_payload", "pattern": "register_activation_hook.*(?:eval|base64|exec|wp_insert_user|update_option\\s*\\(\\s*['\"]admin_email)", "severity": "critical", "description": "Payload executes on plugin activation"},
  {"id": "pl_filter_hijack", "pattern": "add_filter\\s*\\(\\s*['\"](?:the_content|wp_head|wp_footer|login_redirect)['\"].*(?:eval|base64|exec)", "severity": "critical", "description": "Content/login filter hijacked with malicious code"},
  {"id": "pl_transient_payload", "pattern": "set_transient\\s*\\(.*(?:eval|base64_decode|gzinflate)", "severity": "high", "description": "Malicious payload stored in WP transient"},
  {"id": "pl_mu_plugin_drop", "pattern": "(?:WPMU_PLUGIN_DIR|mu-plugins).*(?:copy|file_put_contents|rename)", "severity": "critical", "description": "Dropping file into mu-plugins (auto-loaded, no deactivation)"},
  {"id": "pl_wp_mail_intercept", "pattern": "add_filter\\s*\\(\\s*['\"]wp_mail['\"].*(?:\\$_(?:GET|POST|REQUEST)|base64)", "severity": "high", "description": "WordPress mail function intercepted/modified"},
  {"id": "pl_disable_updates", "pattern": "add_filter\\s*\\(\\s*['\"](?:auto_update_plugin|auto_update_theme)['\"].*__return_false", "severity": "medium", "description": "Auto-updates disabled - prevents security patches"},
  {"id": "pl_hide_plugin", "pattern": "add_filter\\s*\\(\\s*['\"]all_plugins['\"].*unset", "severity": "high", "description": "Plugin hiding itself from admin plugin list"},
  {"id": "pl_login_capture", "pattern": "add_action\\s*\\(\\s*['\"]wp_login['\"].*(?:wp_remote_post|file_put_contents|mail\\s*\\()", "severity": "critical", "description": "Login credentials being captured and exfiltrated"},
  {"id": "pl_cookie_steal", "pattern": "\\$_COOKIE.*(?:wp_remote_post|file_get_contents\\s*\\(\\s*['\"]http|mail\\s*\\()", "severity": "critical", "description": "Cookie data being sent to external server"},
  {"id": "pl_global_inject", "pattern": "\\$GLOBALS\\s*\\[\\s*['\"].*['\"]\\s*\\]\\s*=.*(?:eval|base64_decode|create_function)", "severity": "critical", "description": "Malicious code injected into PHP globals"},
  {"id": "pl_autoload_backdoor", "pattern": "spl_autoload_register\\s*\\(.*(?:eval|base64|exec|include.*\\$)", "severity": "critical", "description": "PHP autoloader hijacked for code execution"},
  {"id": "pl_envato_null", "pattern": "(?:envato|themeforest|codecanyon|purchase_code).*(?:true|valid|verified|activated).*(?:return|=)", "severity": "high", "description": "Envato/CodeCanyon license check bypassed"},
  {"id": "pl_gpl_trap", "pattern": "(?:GPL|gpl|General Public License).*(?:null|crack|free|pirat)", "severity": "medium", "description": "GPL license marker with nulled references"}
]
